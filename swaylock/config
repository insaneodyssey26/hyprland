indicator
clock
timestr=%I:%M
datestr=%A, %B %d
font=Geist Medium
font-size=24

# Effects: wallpaper blur + vignette
screenshots
effect-blur=12x8
effect-vignette=0.5:0.5
fade-in=0.2

# Indicator ring sizing & styling
indicator-radius=90
indicator-thickness=6
indicator-idle-visible
indicator-image=/home/masum/hyprland/swaylock/avatar.png

# Colors (glass style matching Matugen palette)
# Ring
ring-color=c7c6c666
ring-clear-color=8e919288
ring-caps-lock-color=ffb4ab88
ring-ver-color=c7c6c6cc
ring-wrong-color=ffb4abdd

# Inside
inside-color=14131340
inside-clear-color=14131340
inside-caps-lock-color=14131340
inside-ver-color=14131360
inside-wrong-color=ffb4ab40

# Key highlight
key-hl-color=c7c6c6ff
bs-hl-color=ffb4abff
separator-color=00000000
line-uses-inside

# Text inside ring
text-color=e5e2e1ff
text-clear-color=e5e2e1ff
text-caps-lock-color=ffb4abff
text-ver-color=c7c6c6ff
text-wrong-color=ffb4abff

# Grace period
grace=2
grace-no-mouse
