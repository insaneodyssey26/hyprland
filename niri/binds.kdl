// ==============================================================================
// NIRI - KEY & MOUSE BINDINGS
// ==============================================================================

binds {
    // Session & Compositor Control
    Mod+Shift+M { quit; }
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+Shift+P { power-off-monitors; }

    // Applications
    Mod+T { spawn "kitty"; }
    Mod+Shift+T { spawn "foot"; }
    Mod+D { spawn "quickshell" "ipc" "-p" "/home/masum/dotfiles/quickshell/shell.qml" "call" "launcher" "toggle"; }
    Mod+G { spawn "quickshell" "ipc" "-p" "/home/masum/dotfiles/quickshell/shell.qml" "call" "finder" "toggle"; }
    Mod+Q { close-window; }
    Mod+B { spawn "brave-origin-beta"; }
    Mod+Shift+B { spawn "brave-origin-beta" "--disable-gpu-compositing"; }
    Mod+E { spawn "nautilus"; }
    Mod+Shift+E { spawn "kitty" "-e" "yazi"; }
    Mod+C { spawn "gnome-calculator"; }
    Mod+Shift+R { spawn "rnote"; }
    Mod+Y { spawn "bash" "-c" "color=$(niri msg pick-color 2>/dev/null | grep -o '#[0-9a-fA-F]*' || hyprpicker -a 2>/dev/null || true); [ -n \"$color\" ] && wl-copy \"$color\" && notify-send 'Color Picked' \"$color\" -t 2000"; }
    Mod+L { spawn "/home/masum/dotfiles/scripts/lock.sh"; }
    Pause allow-when-locked=true { spawn "niri" "msg" "action" "power-off-monitors"; }
    Break allow-when-locked=true { spawn "niri" "msg" "action" "power-off-monitors"; }
    Mod+Pause { power-off-monitors; }
    Mod+Escape { spawn "quickshell" "ipc" "-p" "/home/masum/dotfiles/quickshell/shell.qml" "call" "session" "toggle"; }

    // Column & Window Navigation (Horizontal ribbon + vertical stacking)
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-or-workspace-up; }
    Mod+Down  { focus-window-or-workspace-down; }

    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up    { move-window-up-or-to-workspace-up; }
    Mod+Shift+Down  { move-window-down-or-to-workspace-down; }

    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End  { move-column-to-last; }

    // Alt+Tab Desktop Overview
    Alt+Tab { toggle-overview; }

    // Themes & Wallpapers
    Mod+W { spawn "quickshell" "ipc" "-p" "/home/masum/dotfiles/quickshell/shell.qml" "call" "wallpaper" "toggle"; }
    Mod+Shift+W { spawn "/home/masum/dotfiles/scripts/random-wall.sh"; }

    // Column Sizing & Modes
    Mod+R { switch-preset-column-width; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+M { maximize-window-to-edges; }
    Mod+Space { toggle-window-floating; }
    Mod+Shift+Space { switch-focus-between-floating-and-tiling; }
    Mod+O { toggle-overview; }

    // Column & Window Merging / Splitting (Stacking windows vertically in columns)
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Comma  { consume-window-into-column; }
    Mod+Shift+Period { expel-window-from-column; }

    // Pixel-level sizing adjustments
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    // Workspaces (Vertical hierarchy)
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    // Hardware & Media Keys
    XF86AudioRaiseVolume allow-when-locked=true { spawn "bash" "-c" "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+ && quickshell ipc -p /home/masum/dotfiles/quickshell/shell.qml call osd volume"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "bash" "-c" "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- && quickshell ipc -p /home/masum/dotfiles/quickshell/shell.qml call osd volume"; }
    XF86AudioMute        allow-when-locked=true { spawn "bash" "-c" "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle && quickshell ipc -p /home/masum/dotfiles/quickshell/shell.qml call osd volume"; }
    XF86AudioMicMute     allow-when-locked=true { spawn "bash" "-c" "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle && quickshell ipc -p /home/masum/dotfiles/quickshell/shell.qml call osd mic"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "bash" "-c" "brightnessctl set 5%+ && quickshell ipc -p /home/masum/dotfiles/quickshell/shell.qml call osd brightness"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "bash" "-c" "brightnessctl set 5%- && quickshell ipc -p /home/masum/dotfiles/quickshell/shell.qml call osd brightness"; }

    // Utilities & Tools
    Print       { screenshot-screen; }
    Shift+Print { screenshot; }
    Mod+V       { spawn "quickshell" "ipc" "-p" "/home/masum/dotfiles/quickshell/shell.qml" "call" "clipboard" "toggle"; }
    Mod+X       { spawn "quickshell" "ipc" "-p" "/home/masum/dotfiles/quickshell/shell.qml" "call" "tasks" "toggle"; }
    Mod+P       { spawn "quickshell" "ipc" "-p" "/home/masum/dotfiles/quickshell/shell.qml" "call" "projects" "toggle"; }
    Mod+K       { spawn "/home/masum/dotfiles/scripts/toggle_osk.sh"; }
    Mod+Period  { spawn "quickshell" "ipc" "-p" "/home/masum/dotfiles/quickshell/shell.qml" "call" "emoji" "toggle"; }
    Mod+N       { spawn "quickshell" "ipc" "-p" "/home/masum/dotfiles/quickshell/shell.qml" "call" "notifications" "toggle"; }
    Mod+S       { spawn "quickshell" "ipc" "-p" "/home/masum/dotfiles/quickshell/shell.qml" "call" "controls" "toggle"; }

    Mod+MouseBack    { focus-column-left; }
    Mod+MouseForward { focus-column-right; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-column-right; }
    Mod+WheelScrollUp   cooldown-ms=150 { focus-column-left; }
}
